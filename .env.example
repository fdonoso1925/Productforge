# ProductForge — variables de entorno
# Copia las del BACKEND a backend/.env y las del FRONTEND a frontend/.env.local.
# Nunca subas los archivos .env reales al repo.
#
# Con Supabase local (`npx supabase start`) los valores de URL y claves los imprime
# `npx supabase status`.

# ───────────────────────── BACKEND (backend/.env) ─────────────────────────

# URL del proyecto Supabase. Local: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
# Service role key: SOLO backend. Salta RLS; nunca la expongas al frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto JWT (proyectos con firma HS256 / Supabase local). Si tu proyecto usa
# claves asimétricas (JWKS), déjalo vacío y el backend usa
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=

# Emails que pueden usar la app, separados por coma (uso personal).
ALLOWED_EMAILS=tu-email@gmail.com

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# development | production. En production la app NO arranca si la configuración es insegura
# o incompleta (URLs locales, claves vacías…) y no publica /docs. La imagen Docker ya la trae.
ENVIRONMENT=development

# Freno ante loops en los endpoints con IA, por usuario (no es una cuota de costo).
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=300

# true: el worker de jobs corre dentro de la API (cómodo en desarrollo).
# En producción: false y un segundo servicio con `python -m app.worker`.
WORKER_INLINE=true

# Claude. Solo backend. Si se deja vacía, el SDK usa otra credencial del entorno.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_OUTLINE=claude-sonnet-5-5
CLAUDE_MODEL_CONTENT=claude-sonnet-5-5
# low | medium | high | xhigh | max (Opus 5.5 usa medium si no se indica).
CLAUDE_EFFORT=high

# URL pública del frontend (a dónde vuelve el navegador tras autorizar Google Drive).
FRONTEND_URL=http://localhost:3000

# Google Drive (OAuth). Solo backend. Cómo crear las credenciales: ver CLAUDE.md → Google Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/storage/drive/callback
# Clave Fernet que cifra los tokens OAuth en la base. Genera con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Creativos para Meta Ads (módulo en planificación, ver PLAN-CREATIVOS.md). Solo backend.
# Gemini NO tiene cuota gratis para imágenes: usarlo requiere facturación activa en Google.
GEMINI_API_KEY=
# Pixabay: fotos de stock gratis (100 peticiones/60 s). https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Orden de proveedores de imagen; el primero que pueda atender la petición la atiende.
IMAGE_PROVIDERS=pixabay
# Meta Marketing API (subir anuncios EN PAUSA y leer métricas). Todo opcional; sin token queda apagado.
# Token de un «usuario del sistema» con permiso ads_management (Business Manager). Solo aquí, nunca en el frontend.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_PIXEL_ID=
META_API_VERSION=v25.0
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_PRICE_USD=0.034
# Tope diario de gasto en Gemini, en USD. 0 = Gemini apagado aunque haya clave (por defecto).
GEMINI_DAILY_USD_CAP=0

# ──────────────────────── FRONTEND (frontend/.env.local) ───────────────────

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon/publishable key: es pública por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
