<style>
.h { font-size: {{ fs.headline }}px; }
.steps { margin-top: 44px; }
.step { display: flex; align-items: center; margin-top: 22px; padding: 22px 28px; border: 3px solid {{ c.border }}; border-radius: 26px; }
.num { flex: none; width: 76px; height: 76px; border-radius: 38px; margin-right: 28px; background: {{ c.accent }}; color: {{ c.accent_fg }}; font-family: '{{ f.heading }}'; font-weight: {{ f.heading_weight }}; font-size: 40px; line-height: 76px; text-align: center; }
.step span.t { font-size: {{ fs.item }}px; line-height: 1.18; font-weight: 700; }
.cta { align-self: flex-start; margin-top: 46px; }
</style>
<div class="safe">
  {% if copy.kicker %}<div class="kicker">{{ copy.kicker }}</div>{% endif %}
  <div class="h">{{ copy.headline | hl }}</div>
  <div class="steps">
    {% for item in copy.bullets %}<div class="step"><span class="num">{{ loop.index }}</span><span class="t">{{ item }}</span></div>{% endfor %}
  </div>
  {% if copy.cta_text %}<div class="cta">{{ copy.cta_text }}</div>{% endif %}
</div>
