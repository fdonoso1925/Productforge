<style>
.ring { position: absolute; border-radius: 50%; border: 36px solid {{ c.accent }}; opacity: 0.16; }
.r1 { right: -300px; top: -140px; width: 620px; height: 620px; }
.r2 { left: -380px; bottom: -380px; width: 760px; height: 760px; }
.h { font-size: {{ fs.headline }}px; }
.cta { align-self: flex-start; margin-top: 52px; }
</style>
<div class="ring r1"></div>
<div class="ring r2"></div>
<div class="safe">
  {% if copy.kicker %}<div class="kicker">{{ copy.kicker }}</div>{% endif %}
  <div class="h">{{ copy.headline }}</div>
  {% if copy.subheadline %}<div class="sub">{{ copy.subheadline }}</div>{% endif %}
  {% if copy.cta_text %}<div class="cta">{{ copy.cta_text }}</div>{% endif %}
</div>
