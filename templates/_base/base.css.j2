{# Estilos compartidos. Todos los valores salen de template.json (validados como hex / px). #}
{% set p = t.palette %}
{% for f in t.font_faces() %}
@font-face { font-family: '{{ f.family }}'; font-weight: {{ f.weight }}; src: url('{{ f.url }}'); }
{% endfor %}
:root {
  --primary: {{ p.primary }}; --secondary: {{ p.secondary }}; --accent: {{ p.accent }};
  --bg: {{ p.background }}; --surface: {{ p.surface }}; --text: {{ p.text }}; --muted: {{ p.muted }};
  --on-primary: {{ p.on_primary }}; --tip: {{ p.tip }}; --warning: {{ p.warning }}; --exercise: {{ p.exercise }};
  --radius: {{ t.style.radius }};
  --heading: '{{ t.fonts.heading.family }}', sans-serif;
  --body: '{{ t.fonts.body.family }}', sans-serif;
}
@page {
  size: A4;
  margin: 22mm 20mm 24mm 20mm;
  background: var(--bg);
  {% if t.style.paper == 'lined' %}
  background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 8.4mm, #C7D2FE 8.4mm, #C7D2FE 8.6mm);
  {% endif %}
  @bottom-center {
    content: counter(page);
    font-family: var(--body); font-size: 9pt; color: var(--muted);
  }
  @bottom-right {
    content: string(doc-title);
    font-family: var(--body); font-size: 8pt; color: var(--muted);
  }
}
@page cover { margin: 0; @bottom-center { content: none; } @bottom-right { content: none; } }
@page landscape { size: A4 landscape; margin: 12mm; }
html { font-family: var(--body); font-size: 10.5pt; line-height: 1.55; color: var(--text); }
body { margin: 0; }
h1, h2, h3, h4 { font-family: var(--heading); font-weight: {{ t.fonts.heading.weights[0] }}; color: var(--primary); line-height: 1.2;
  {% if t.style.heading_case == 'uppercase' %}text-transform: uppercase; letter-spacing: 0.02em;{% endif %} }
h1 { font-size: 24pt; margin: 0 0 6mm; }
h2 { font-size: 15pt; margin: 8mm 0 3mm; }
h3 { font-size: 12pt; margin: 5mm 0 2mm; color: var(--secondary); }
p { margin: 0 0 3mm; orphans: 3; widows: 3; }
ul, ol { margin: 0 0 3mm; padding-left: 6mm; }
li { margin-bottom: 1.2mm; }

.chapter { break-before: page; }
.chapter-label { font-family: var(--body); font-size: 9pt; font-weight: 700; color: var(--accent);
  text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 2mm; }
{% if t.style.decoration == 'rule' %}
.chapter h1 { border-bottom: 1.5pt solid var(--accent); padding-bottom: 3mm; }
{% elif t.style.decoration == 'block' %}
.chapter h1 { background: var(--primary); color: var(--on-primary); padding: 5mm 6mm; border-radius: var(--radius); }
{% elif t.style.decoration == 'diagonal' %}
.chapter h1 { background: var(--accent); color: var(--primary); padding: 4mm 6mm; transform: skewX(-8deg); }
{% endif %}
.summary { font-size: 11.5pt; color: var(--muted); margin-bottom: 6mm; }
.lead { font-size: 12pt; }

/* Callouts */
.callout { margin: 4mm 0; padding: 3.5mm 4.5mm; break-inside: avoid; border-radius: var(--radius); }
.callout .callout-title { font-weight: 700; margin-bottom: 1mm; }
{% for kind in ['tip', 'warning', 'exercise'] %}
{% set c = p[kind] %}
{% if t.style.callout == 'boxed' %}
.callout-{{ kind }} { background: {{ c }}14; border: 1pt solid {{ c }}; }
{% elif t.style.callout == 'left-bar' %}
.callout-{{ kind }} { background: {{ c }}0F; border-left: 3.5pt solid {{ c }}; border-radius: 0; }
{% elif t.style.callout == 'pill' %}
.callout-{{ kind }} { background: {{ c }}1F; border-radius: 6mm; padding: 4mm 6mm; }
{% else %}
.callout-{{ kind }} { background: #FEF3C7; border-top: 6pt solid {{ c }}; transform: rotate(-0.6deg); }
{% endif %}
.callout-{{ kind }} .callout-title { color: {{ c }}; }
{% endfor %}

.example { background: var(--surface); border-radius: var(--radius); padding: 3.5mm 4.5mm; margin: 3mm 0; break-inside: avoid; }
.example-label { font-size: 8.5pt; font-weight: 700; color: var(--secondary); text-transform: uppercase; letter-spacing: 0.08em; }
ol.steps { counter-reset: step; list-style: none; padding-left: 0; }
ol.steps li { counter-increment: step; padding-left: 9mm; position: relative; margin-bottom: 2mm; }
ol.steps li::before { content: counter(step); position: absolute; left: 0; top: 0; width: 6mm; height: 6mm;
  border-radius: 3mm; background: var(--primary); color: var(--on-primary); font-weight: 700; font-size: 8.5pt;
  text-align: center; line-height: 6mm; }

/* Índice */
.toc { break-after: page; }
.toc ol { list-style: none; padding: 0; }
.toc li { margin-bottom: 2.5mm; font-size: 11pt; }
.toc a { color: var(--text); text-decoration: none; }
.toc a::after { content: leader('.') target-counter(attr(href), page); color: var(--muted); }

/* Portada */
.cover { page: cover; position: relative; width: 210mm; height: 297mm; overflow: hidden; break-after: page; }
.cover-inner { position: absolute; left: 20mm; right: 20mm; z-index: 2; }
.mockup { z-index: 2; }
.cover-art { position: absolute; left: 0; top: 0; width: 210mm; height: 297mm; z-index: 1; }
.cover-art img { width: 210mm; height: 297mm; object-fit: cover; }
.cover-veil { position: absolute; left: 0; top: 0; width: 210mm; height: 297mm; }
.cover-kicker { font-size: 9pt; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
.cover-title { font-family: var(--heading); font-weight: {{ t.fonts.heading.weights[0] }}; font-size: 34pt; line-height: 1.08; margin: 4mm 0; string-set: doc-title content();
  {% if t.style.heading_case == 'uppercase' %}text-transform: uppercase;{% endif %} }
.cover-title.long { font-size: 24pt; }
.mockup-book.long { font-size: 10pt; }
.cover-subtitle { font-size: 13pt; margin-bottom: 6mm; }
.cover-promise { font-size: 11pt; font-weight: 700; padding: 3mm 5mm; display: inline-block; border-radius: var(--radius); }
.mockup { position: absolute; width: 70mm; height: 96mm; }
.mockup-back { position: absolute; left: 4mm; top: 4mm; width: 70mm; height: 96mm; background: #00000033; border-radius: 1.5mm; }
.mockup-book { position: absolute; left: 0; top: 0; width: 70mm; height: 96mm; background: var(--primary);
  border-radius: 1mm 2mm 2mm 1mm; border-left: 4mm solid var(--secondary); padding: 8mm 6mm; box-sizing: border-box;
  color: var(--on-primary); font-family: var(--heading); font-weight: {{ t.fonts.heading.weights[0] }}; font-size: 13pt; line-height: 1.15; }
.mockup-book small { display: block; margin-top: 4mm; font-family: var(--body); font-size: 7pt; opacity: 0.85; }
.deco { position: absolute; }

/* Checklist / workbook */
.check-group { margin-bottom: 6mm; break-inside: avoid-page; }
.check-item { display: flex; gap: 3mm; margin-bottom: 2.5mm; break-inside: avoid; }
.box { flex: none; width: 4.5mm; height: 4.5mm; border: 1.2pt solid var(--primary); border-radius: 1mm; margin-top: 0.6mm; }
.check-detail { color: var(--muted); font-size: 9.5pt; }
.write { margin: 3mm 0 6mm; break-inside: avoid; }
.write-line { height: 8.5mm; border-bottom: 0.8pt solid var(--muted); }

/* Tablas genéricas (blueprint, planner) */
/* Infografías, fotos y diagramas */
.visual { margin: 5mm 0; break-inside: avoid; }
.visual-title { font-family: var(--heading); font-weight: {{ t.fonts.heading.weights[0] }}; font-size: 11pt; color: var(--primary); margin-bottom: 2.5mm; }
.visual svg { display: block; width: 100%; height: auto; }
.visual figcaption { font-size: 8.5pt; color: var(--muted); margin-top: 2mm; text-align: center; }
.photo { margin: 0 0 5mm; }
.photo img { display: block; width: 100%; height: 62mm; object-fit: cover; border-radius: var(--radius); }
.photo figcaption { font-size: 8.5pt; color: var(--muted); margin-top: 1.5mm; }
.phase-board .visual { margin: 4mm 0 5mm; }
.chips h3 { margin-top: 0; }
.chip { padding: 2mm 3mm; margin-bottom: 1.8mm; border-radius: var(--radius); font-size: 9.5pt; break-inside: avoid; }
.chips-ok .chip { background: var(--surface); border-left: 1.2mm solid var(--tip); }
.chips-warn .chip { background: var(--surface); border-left: 1.2mm solid var(--warning); }
.card { background: var(--surface); border-radius: var(--radius); padding: 5mm; margin-bottom: 5mm; break-inside: avoid; }
.meta { display: flex; gap: 6mm; font-size: 9pt; color: var(--muted); margin-bottom: 2mm; }
.meta b { color: var(--text); }
.cols { display: flex; gap: 5mm; }
.cols > div { flex: 1; }
.badge { display: inline-block; background: var(--primary); color: var(--on-primary); font-weight: 700;
  border-radius: var(--radius); padding: 1mm 3mm; font-size: 9pt; }
.copy { border: 1pt dashed var(--muted); border-radius: var(--radius); padding: 4mm; margin: 2mm 0 1mm; white-space: pre-wrap; background: var(--bg); }
.map-page { page: landscape; }
.map-page img { display: block; margin: 0 auto; }
{{ t.extra_css }}
