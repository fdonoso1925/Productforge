{% macro callout(c, labels) -%}
<div class="callout callout-{{ c.kind }}">
  <div class="callout-title">{{ labels[c.kind] }}{% if c.title %}: {{ c.title }}{% endif %}</div>
  <div>{{ c.text }}</div>
</div>
{%- endmacro %}

{% macro paragraphs(items, cls='') -%}
{% for text in items %}<p{% if cls %} class="{{ cls }}"{% endif %}>{{ text }}</p>{% endfor %}
{%- endmacro %}

{% macro bullets(items) -%}
{% if items %}<ul>{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
{%- endmacro %}

{% macro steps(items) -%}
{% if items %}<ol class="steps">{% for i in items %}<li>{{ i }}</li>{% endfor %}</ol>{% endif %}
{%- endmacro %}

{% macro visual(v, ctx) -%}
{% if v %}{% set svg = visual_svg(v, ctx.market) %}{% if svg %}
<figure class="visual"><div class="visual-title">{{ v.title }}</div>{{ svg }}{% if v.caption %}<figcaption>{{ v.caption }}</figcaption>{% endif %}</figure>
{% endif %}{% endif %}
{%- endmacro %}

{% macro photo(src, caption) -%}
{% if src %}<figure class="photo"><img src="{{ src }}" alt="{{ caption }}"/>{% if caption %}<figcaption>{{ caption }}</figcaption>{% endif %}</figure>{% endif %}
{%- endmacro %}

{% macro write_lines(n) -%}
<div class="write">{% for _ in range(n) %}<div class="write-line"></div>{% endfor %}</div>
{%- endmacro %}

{% macro toc(entries, labels) -%}
<section class="toc">
  <h1>{{ labels.toc }}</h1>
  <ol>{% for e in entries %}<li><a href="#{{ e.id }}">{{ e.title }}</a></li>{% endfor %}</ol>
</section>
{%- endmacro %}
