{# Portada: título, subtítulo, promesa y mockup simple. Variantes según style.cover.
   cover.art = SVG de arte generativo (capa bajo el texto); cover.bg = imagen propia (data URI) con
   su velo: con imagen la portada es siempre "full-bleed" (texto claro sobre velo oscuro). #}
{# Los campos de portada son opcionales: quien no los pasa obtiene la portada de siempre. #}
{% set art = cover.get("art") %}
{% set bg = cover.get("bg") %}
{% set veil = cover.get("veil") or 0 %}
{% set photo = cover.get("photo") %}
{% set design = cover.get("design") or "template" %}
{% set s = "full-bleed" if bg else t.style.cover %}
{% set p = t.palette %}
{# Títulos largos (comunes en la IA) bajan de tamaño para no desbordar la portada. #}
{% set long = cover.title|length > 60 %}
{# Libro de la portada: tapa diseñada (color de marca, un círculo y un filete de acento), lomo
   con su pliegue, canto de las hojas y tapa trasera que asoman (grosor), luz suave y sombra en el
   piso. Todo con capas de CSS que WeasyPrint sí dibuja (gradientes; sin box-shadow ni filtros). #}
{% macro mockup(left, top) -%}
{% set book_bg = p.secondary if s in ["full-bleed", "split"] else p.primary %}
<div class="mockup" style="left: {{ left }}; top: {{ top }}; transform: rotate(-4deg);">
  <div class="mk-floor"></div>
  <div class="mk-board" style="background: {{ book_bg }};"></div>
  <div class="mk-pages"></div>
  <div class="mk-cover{% if long %} long{% endif %}{% if photo %} with-photo{% endif %}" style="background: {{ book_bg }}; color: {{ p.on_primary }};">
    {% if photo %}
    {# Foto del tema arriba (si el outline la pidió); el título va debajo, sobre el color. #}
    <div class="mk-photo"><img src="{{ photo }}" alt=""></div>
    <div class="mk-photo-edge" style="background: {{ p.accent }};"></div>
    {% else %}
    <div class="mk-shape" style="background: {{ p.accent }};"></div>
    <div class="mk-shape small" style="border-color: {{ p.accent }};"></div>
    {% endif %}
    <div class="mk-text">
      <div class="mk-rule" style="background: {{ p.accent }};"></div>
      <div class="mk-title">{{ cover.title }}</div>
      {% if cover.product_name != cover.title %}<div class="mk-name">{{ cover.product_name }}</div>{% endif %}
    </div>
    <div class="mk-foot" style="background: {{ p.accent }};"></div>
    <div class="mk-light"></div>
    <div class="mk-spine"></div>
  </div>
</div>
{%- endmacro %}
{% if design == "editorial" %}
{# Tapa editorial: un libro impreso de verdad. Papel claro, título grande en tinta oscura,
   subtítulo dorado entre rombos, foto (imagen propia > foto del tema) o un emblema al centro que se
   funde con el papel, y la promesa al pie entre filetes. Colores legibles: editorial_colors. #}
{% set e = editorial_colors(p) %}
{% set img = bg or photo %}
{% set n = cover.title|length %}
{% set size = "xs" if n > 70 else "s" if n > 40 else "m" if n > 22 else "l" if n > 12 else "xl" %}
<section class="cover cover-ed" style="background: {{ e.paper }}; color: {{ e.ink }};">
  {% if not img %}<div class="ed-glow" style="background: radial-gradient(ellipse 60% 45% at 50% 58%, {{ e.glow }} 0%, {{ e.fade }} 100%);"></div>{% endif %}
  {# Sin foto, un emblema sobrio (el arte generativo, pensado para fondos de color, se ve
     pesado sobre papel claro). #}
  <div class="ed-figure">
    {% if img %}<img src="{{ img }}" alt="">
    {# Una sola viñeta radial que funde la foto con el papel (varias capas dejan costuras). #}
    <div class="ed-fade" style="background: radial-gradient(ellipse 56% 50% at 50% 50%, {{ e.fade }} 50%, {{ e.paper }} 100%);"></div>
    {% else %}<div class="ed-ring" style="border-color: {{ e.gold }};"></div><div class="ed-dia ed-dia-big" style="background: {{ e.gold }};"></div>
    {% endif %}
  </div>
  <div class="ed-head">
    {% if cover.product_name and cover.product_name != cover.title %}<div class="ed-kicker" style="color: {{ e.gold }};">{{ cover.product_name }}</div>{% endif %}
    <div class="ed-title ed-{{ size }}">{{ cover.title }}</div>
    {% if cover.subtitle %}
    <table class="ed-sub" style="color: {{ e.gold }};"><tr>
      <td class="ed-sub-dia"><span class="ed-dia" style="background: {{ e.gold }};"></span></td>
      <td class="ed-sub-text">{{ cover.subtitle }}</td>
      <td class="ed-sub-dia"><span class="ed-dia" style="background: {{ e.gold }};"></span></td>
    </tr></table>
    {% endif %}
  </div>
  <div class="ed-foot">
    <div class="ed-dia ed-dia-foot" style="background: {{ e.gold }};"></div>
    {% if cover.promise %}
    <table class="ed-tag"><tr>
      <td class="ed-line-cell"><div class="ed-line" style="background: {{ e.gold }};"></div></td>
      <td class="ed-tag-text">{{ cover.promise }}</td>
      <td class="ed-line-cell"><div class="ed-line" style="background: {{ e.gold }};"></div></td>
    </tr></table>
    {% endif %}
  </div>
</section>
{% else %}
<section class="cover" style="background: {% if s == 'full-bleed' %}{{ p.primary }}{% elif s == 'centered' %}{{ p.surface }}{% else %}{{ p.background }}{% endif %};
  color: {% if s == 'full-bleed' %}{{ p.on_primary }}{% else %}{{ p.text }}{% endif %};">
  {% if bg %}
  {% elif t.style.decoration == 'blob' %}
  <div class="deco" style="right: -40mm; top: -30mm; width: 140mm; height: 140mm; border-radius: 70mm; background: {{ p.accent }}55;"></div>
  <div class="deco" style="left: -30mm; bottom: -40mm; width: 110mm; height: 110mm; border-radius: 55mm; background: {{ p.secondary }}33;"></div>
  {% elif t.style.decoration == 'dots' %}
  <div class="deco" style="left: 0; top: 0; width: 210mm; height: 297mm; background-image: radial-gradient({{ p.accent }} 1.4mm, transparent 1.6mm); background-size: 12mm 12mm; opacity: 0.35;"></div>
  {% elif t.style.decoration == 'diagonal' %}
  <div class="deco" style="left: -20mm; top: 180mm; width: 260mm; height: 40mm; background: {{ p.accent }}; transform: rotate(-12deg);"></div>
  {% endif %}

  {% if bg %}
  <div class="cover-art"><img src="{{ bg }}" alt=""><div class="cover-veil" style="background: {{ p.primary }}; opacity: {{ veil }};"></div></div>
  {% elif art %}
  <div class="cover-art">{{ art|safe }}</div>
  {% endif %}
  {% if s == 'split' %}
  <div class="deco" style="left: 0; top: 0; width: 84mm; height: 297mm; background: {{ p.primary }};"></div>
  {{ mockup('8mm', '100mm') }}
  <div class="cover-inner" style="left: 96mm; top: 70mm;">
  {% elif s == 'band' %}
  <div class="deco" style="left: 0; top: 0; width: 210mm; height: 150mm; background: {{ p.primary }};"></div>
  <div class="cover-inner" style="top: 30mm; color: {{ p.on_primary }};">
  {% elif s == 'notebook' %}
  <div class="deco" style="left: 0; top: 0; width: 210mm; height: 297mm; background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 8.4mm, #C7D2FE 8.4mm, #C7D2FE 8.6mm);"></div>
  <div class="deco" style="left: 26mm; top: 0; width: 0.8mm; height: 297mm; background: #FCA5A5;"></div>
  <div class="deco" style="left: 70mm; top: 34mm; width: 70mm; height: 14mm; background: {{ p.accent }}CC; transform: rotate(-3deg);"></div>
  <div class="cover-inner" style="left: 36mm; top: 62mm;">
  {% else %}
  <div class="cover-inner" style="top: 48mm;">
  {% endif %}
    {% if cover.product_name and cover.product_name != cover.title %}<div class="cover-kicker"{% if bg %} style="color: {{ p.on_primary }}; opacity: 0.85;"{% endif %}>{{ cover.product_name }}</div>{% endif %}
    <div class="cover-title{% if long %} long{% endif %}" style="color: {% if s in ['full-bleed', 'band'] %}{{ p.on_primary }}{% else %}{{ p.primary }}{% endif %};">{{ cover.title }}</div>
    <div class="cover-subtitle">{{ cover.subtitle }}</div>
    {% if cover.promise %}
    <div class="cover-promise" style="background: {% if bg %}{{ p.on_primary }}; color: {{ p.primary }}{% elif s in ['full-bleed', 'band'] %}{{ p.accent }}; color: {{ p.primary }}{% else %}{{ p.primary }}; color: {{ p.on_primary }}{% endif %};">{{ cover.promise }}</div>
    {% endif %}
  </div>
  {% if s in ['centered', 'full-bleed', 'notebook'] %}{{ mockup('70mm', '150mm') }}{% elif s == 'band' %}{{ mockup('124mm', '168mm') }}{% endif %}
</section>
{% endif %}
