<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.seo_title or c.hero.headline }}</title>
<meta name="description" content="{{ c.seo_description }}">
<style>
:root {
  --primary: {{ p.primary }}; --secondary: {{ p.secondary }}; --accent: {{ p.accent }};
  --bg: {{ p.background }}; --surface: {{ p.surface }}; --text: {{ p.text }}; --muted: {{ p.muted }};
  --on-primary: {{ p.on_primary }}; --on-accent: {{ on_accent }}; --radius: {{ radius }};
  --heading: {{ heading_font|safe }}; --body: {{ body_font|safe }};
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.6 var(--body); padding-bottom: 76px; -webkit-text-size-adjust: 100%; }
h1, h2, h3 { font-family: var(--heading); line-height: 1.15; margin: 0 0 .5em; }
h1 { font-size: clamp(30px, 6.5vw, 52px); }
h2 { font-size: clamp(24px, 4.5vw, 36px); }
h3 { font-size: 19px; }
p { margin: 0 0 1em; }
.wrap { max-width: 760px; margin: 0 auto; padding: 0 20px; }
.wide { max-width: 1000px; }
section { padding: 56px 0; }
.alt { background: var(--surface); }
.hero { background: linear-gradient(135deg, var(--primary), var(--secondary)); color: var(--on-primary); padding: 64px 0 56px; }
.eyebrow { display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.16); margin-bottom: 18px; }
.hero .sub { font-size: 19px; opacity: .95; }
.ticks { list-style: none; padding: 0; margin: 22px 0 28px; display: grid; gap: 10px; }
.ticks li { padding-left: 32px; position: relative; font-weight: 600; }
.ticks li::before { content: "✓"; position: absolute; left: 0; top: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 14px; display: grid; place-items: center; line-height: 1; margin-top: 3px; }
.btn { display: inline-block; background: var(--accent); color: var(--on-accent); font: 800 18px/1.2 var(--heading); padding: 18px 30px; border-radius: 999px; text-decoration: none; text-align: center; box-shadow: 0 8px 22px rgba(0,0,0,.22); transition: transform .15s; }
.btn:hover { transform: translateY(-2px); }
.btn.block { display: block; }
.micro { font-size: 14px; opacity: .85; margin: 12px 0 0; }
.cross { list-style: none; padding: 0; margin: 20px 0; display: grid; gap: 12px; }
.cross li { padding-left: 34px; position: relative; }
.cross li::before { content: "✕"; position: absolute; left: 0; top: 2px; width: 24px; height: 24px; border-radius: 50%; background: var(--surface); color: var(--secondary); font-weight: 800; font-size: 13px; display: grid; place-items: center; }
.alt .cross li::before { background: var(--bg); }
.mechanism { border-left: 5px solid var(--primary); background: var(--surface); padding: 18px 20px; border-radius: 0 var(--radius) var(--radius) 0; margin: 24px 0 0; }
.alt .mechanism { background: var(--bg); }
.mechanism strong { display: block; font-family: var(--heading); font-size: 20px; color: var(--primary); margin-bottom: 6px; }
.steps { list-style: none; counter-reset: s; padding: 0; margin: 28px 0 0; display: grid; gap: 22px; }
.steps li { counter-increment: s; padding-left: 62px; position: relative; }
.steps li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 44px; height: 44px; border-radius: 50%; background: var(--primary); color: var(--on-primary); font: 800 20px/44px var(--heading); text-align: center; }
.cards { display: grid; gap: 16px; margin-top: 28px; }
.card { background: var(--bg); border: 1px solid rgba(0,0,0,.08); border-radius: var(--radius); padding: 22px; }
.alt .card { background: var(--bg); }
.card h3 { margin-bottom: .3em; }
.card p:last-child { margin-bottom: 0; }
.tag { display: inline-block; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; padding: 3px 10px; border-radius: 999px; margin-bottom: 10px; background: var(--primary); color: var(--on-primary); }
.tag.bonus { background: var(--accent); color: var(--on-accent); }
.tag.bump { background: var(--surface); color: var(--text); border: 1px solid rgba(0,0,0,.12); }
.cols { display: grid; gap: 16px; margin-top: 24px; }
.col h3 { display: flex; gap: 8px; align-items: center; }
.col ul { padding-left: 20px; margin: 0; display: grid; gap: 8px; }
.proof { display: grid; gap: 16px; margin-top: 24px; }
blockquote { margin: 0; padding: 20px 22px; background: var(--bg); border-radius: var(--radius); border-left: 5px solid var(--accent); font-size: 18px; }
blockquote footer { margin-top: 10px; font-size: 14px; color: var(--muted); font-weight: 700; }
.offer { border: 3px solid var(--primary); border-radius: calc(var(--radius) + 6px); padding: 30px 24px; background: var(--bg); text-align: center; box-shadow: 0 16px 40px rgba(0,0,0,.12); }
.price { font: 800 clamp(40px, 9vw, 60px)/1 var(--heading); color: var(--primary); margin: 18px 0; }
.included { text-align: left; list-style: none; padding: 0; margin: 20px 0; display: grid; gap: 10px; }
.included li { padding-left: 30px; position: relative; }
.included li::before { content: "✓"; position: absolute; left: 0; color: var(--primary); font-weight: 800; }
.note { background: var(--surface); border-radius: var(--radius); padding: 14px 18px; margin: 18px 0; font-size: 15px; text-align: left; }
.note.urgent { border-left: 5px solid var(--secondary); }
details { background: var(--bg); border: 1px solid rgba(0,0,0,.1); border-radius: var(--radius); padding: 0 20px; margin-bottom: 12px; }
summary { cursor: pointer; font-weight: 700; padding: 18px 0; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
summary::-webkit-details-marker { display: none; }
summary::after { content: "+"; font-size: 24px; line-height: 1; color: var(--primary); }
details[open] summary::after { content: "–"; }
details p { padding-bottom: 6px; }
.final { background: linear-gradient(135deg, var(--primary), var(--secondary)); color: var(--on-primary); text-align: center; }
footer.legal { padding: 28px 0 40px; font-size: 13px; color: var(--muted); text-align: center; }
.sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: var(--bg); border-top: 1px solid rgba(0,0,0,.12); padding: 10px 16px; display: flex; gap: 12px; align-items: center; justify-content: center; }
.sticky .btn { padding: 13px 24px; font-size: 16px; box-shadow: none; flex: 1; max-width: 420px; }
.sticky .p { font: 800 18px var(--heading); color: var(--primary); white-space: nowrap; }
@media (min-width: 760px) {
  .cards.two { grid-template-columns: 1fr 1fr; }
  .cols { grid-template-columns: 1fr 1fr; }
  .proof.two { grid-template-columns: 1fr 1fr; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .btn { transition: none; } }
</style>
</head>
<body>
<header class="hero">
  <div class="wrap">
    {% if c.hero.eyebrow %}<span class="eyebrow">{{ c.hero.eyebrow }}</span>{% endif %}
    <h1>{{ c.hero.headline }}</h1>
    <p class="sub">{{ c.hero.subheadline }}</p>
    <ul class="ticks">{% for b in c.hero.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    <a class="btn" href="{{ cta }}">{{ c.hero.cta_text }}</a>
    {% if c.hero.microcopy %}<p class="micro">{{ c.hero.microcopy }}</p>{% endif %}
  </div>
</header>

<main>
<section>
  <div class="wrap">
    <h2>{{ c.problem.title }}</h2>
    <p>{{ c.problem.intro }}</p>
    <ul class="cross">{% for x in c.problem.pains %}<li>{{ x }}</li>{% endfor %}</ul>
    <p><strong>{{ c.problem.agitation }}</strong></p>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <h2>{{ c.solution.title }}</h2>
    <p>{{ c.solution.intro }}</p>
    <div class="mechanism"><strong>{{ c.solution.mechanism_name }}</strong>{{ c.solution.mechanism }}</div>
    <ol class="steps">{% for s in c.journey %}<li><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>{% endfor %}</ol>
  </div>
</section>

<section>
  <div class="wrap wide">
    <h2>{{ L.benefits }}</h2>
    <div class="cards two">{% for b in c.benefits %}<div class="card"><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div>{% endfor %}</div>
  </div>
</section>

{% if items %}
<section class="alt">
  <div class="wrap wide">
    <h2>{{ L.inside }}</h2>
    <div class="cards two">
      {% for d in items %}
      <div class="card"><span class="tag {{ d.kind }}">{{ L[d.kind] }}</span><h3>{{ d.title }}</h3><p>{{ d.blurb }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section>
  <div class="wrap wide">
    <div class="cols">
      <div class="col card"><h3>{{ L.for_you }}</h3><ul>{% for x in c.for_you %}<li>{{ x }}</li>{% endfor %}</ul></div>
      <div class="col card"><h3>{{ L.not_for_you }}</h3><ul>{% for x in c.not_for_you %}<li>{{ x }}</li>{% endfor %}</ul></div>
    </div>
  </div>
</section>

{% if c.about %}
<section class="alt"><div class="wrap"><h2>{{ L.about }}</h2><p>{{ c.about }}</p></div></section>
{% endif %}

{% if proofs %}
<section class="alt">
  <div class="wrap wide">
    {% if c.proof.intro %}<h2>{{ c.proof.intro }}</h2>{% endif %}
    <div class="proof{% if proofs|length > 1 %} two{% endif %}">
      {% for q in proofs %}<blockquote>{{ q.text }}{% if q.author %}<footer>— {{ q.author }}</footer>{% endif %}</blockquote>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="oferta">
  <div class="wrap">
    <div class="offer">
      <h2>{{ c.offer.title }}</h2>
      <p>{{ c.offer.intro }}</p>
      {% if items %}<ul class="included">{% for d in items if d.kind != 'bump' %}<li>{{ d.title }}</li>{% endfor %}</ul>{% endif %}
      {% if c.offer.price_text %}<div class="price">{{ c.offer.price_text }}</div>{% endif %}
      {% if c.offer.urgency %}<div class="note urgent">{{ c.offer.urgency }}</div>{% endif %}
      <a class="btn block" href="{{ cta }}">{{ c.offer.cta_text }}</a>
      {% if c.offer.guarantee %}<div class="note"><strong>{{ L.guarantee }}:</strong> {{ c.offer.guarantee }}</div>{% endif %}
    </div>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <h2>{{ L.faq }}</h2>
    {% for f in c.faq %}<details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>{% endfor %}
  </div>
</section>

<section class="final">
  <div class="wrap">
    <h2>{{ c.final_cta.headline }}</h2>
    <p>{{ c.final_cta.text }}</p>
    <a class="btn" href="{{ cta }}">{{ c.final_cta.cta_text }}</a>
  </div>
</section>
</main>

<footer class="legal"><div class="wrap">{{ c.disclaimer }}</div></footer>

<div class="sticky">{% if c.offer.price_text %}<span class="p">{{ c.offer.price_text }}</span>{% endif %}<a class="btn" href="{{ cta }}">{{ c.hero.cta_text }}</a></div>
</body>
</html>
